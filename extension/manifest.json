{
  "manifest_version": 3,
  "name": "Plume",
  "version": "0.1.0",
  "description": "Send from Gmail as your @apache.org address through a local Plume server.",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/dom-text.js", "src/gmail-dom.js", "src/reply-context.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "src/options.html", "open_in_tab": true }
}
